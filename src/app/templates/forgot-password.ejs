<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PH Healthcare - Verification Code</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
    ">
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding: 35px 15px; background-color: #f4f7fb">
      <tr>
        <td align="center">
          <!-- Email Card -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 420px;
              background: #ffffff;
              border-radius: 14px;
              overflow: hidden;
              border: 1px solid #e5e7eb;
            ">
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 24px 20px; background-color: #2563eb">
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 22px;
                    font-weight: 700;
                  ">
                  PH Healthcare
                </h1>

                <p style="margin: 6px 0 0; color: #dbeafe; font-size: 12px">
                  Secure &amp; Trusted Healthcare
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 30px 25px">
                <h2
                  style="
                    margin: 0 0 12px;
                    color: #111827;
                    font-size: 20px;
                    text-align: center;
                  ">
                  Verify Your Account
                </h2>

                <p
                  style="
                    margin: 0 0 22px;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.6;
                    text-align: center;
                  ">
                  Hi <strong style="color: #111827"><%= name %></strong>, use
                  the verification code below to continue.
                </p>

                <!-- OTP -->
                <div
                  style="
                    padding: 18px;
                    background-color: #eff6ff;
                    border: 1px solid #bfdbfe;
                    border-radius: 10px;
                    text-align: center;
                  ">
                  <p
                    style="
                      margin: 0 0 8px;
                      color: #64748b;
                      font-size: 11px;
                      text-transform: uppercase;
                      letter-spacing: 1.5px;
                    ">
                    Verification Code
                  </p>

                  <div
                    style="
                      color: #2563eb;
                      font-size: 32px;
                      font-weight: 700;
                      letter-spacing: 7px;
                    ">
                    <%= otp %>
                  </div>
                </div>

                <p
                  style="
                    margin: 20px 0 0;
                    color: #6b7280;
                    font-size: 12px;
                    text-align: center;
                    line-height: 1.5;
                  ">
                  This code will expire in
                  <strong style="color: #dc2626">5 minutes</strong>.
                </p>

                <p
                  style="
                    margin: 20px 0 0;
                    color: #9ca3af;
                    font-size: 11px;
                    line-height: 1.5;
                    text-align: center;
                  ">
                  If you didn't request this code, you can safely ignore this
                  email.
                </p>
              </td>
            </tr>
            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 16px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e5e7eb;
                ">
                <p style="margin: 0; color: #94a3b8; font-size: 11px">
                  © <%= year %> PH Healthcare · Automated Email
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
```
