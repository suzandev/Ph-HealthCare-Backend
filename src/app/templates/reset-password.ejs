<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PH Healthcare - Password Reset</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
    ">
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding: 35px 15px; background-color: #f4f7fb">
      <tr>
        <td align="center">
          <!-- Email Card -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 420px;
              background-color: #ffffff;
              border-radius: 14px;
              overflow: hidden;
              border: 1px solid #e5e7eb;
            ">
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 24px 20px; background-color: #2563eb">
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 22px;
                    font-weight: 700;
                  ">
                  PH Healthcare
                </h1>

                <p style="margin: 6px 0 0; color: #dbeafe; font-size: 12px">
                  Secure &amp; Trusted Healthcare
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 32px 25px">
                <!-- Success Icon -->
                <div
                  style="
                    width: 52px;
                    height: 52px;
                    margin: 0 auto 18px;
                    background-color: #ecfdf5;
                    border: 1px solid #a7f3d0;
                    border-radius: 50%;
                    text-align: center;
                    line-height: 52px;
                    color: #059669;
                    font-size: 25px;
                    font-weight: 700;
                  ">
                  ✓
                </div>

                <h2
                  style="
                    margin: 0 0 12px;
                    color: #111827;
                    font-size: 20px;
                    text-align: center;
                  ">
                  Password Reset Successful
                </h2>

                <p
                  style="
                    margin: 0 0 20px;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.6;
                    text-align: center;
                  ">
                  Hi <strong style="color: #111827"><%= name %></strong>, your
                  PH Healthcare account password has been successfully updated.
                </p>

                <!-- Security Notice -->
                <div
                  style="
                    padding: 14px 16px;
                    background-color: #f8fafc;
                    border: 1px solid #e5e7eb;
                    border-radius: 9px;
                  ">
                  <p
                    style="
                      margin: 0;
                      color: #475569;
                      font-size: 12px;
                      line-height: 1.6;
                    ">
                    <strong style="color: #111827"> Security notice: </strong>
                    If you did not make this change, please secure your account
                    immediately.
                  </p>
                </div>

                <p
                  style="
                    margin: 20px 0 0;
                    color: #9ca3af;
                    font-size: 11px;
                    line-height: 1.5;
                    text-align: center;
                  ">
                  This is an automated security notification. Please do not
                  reply to this email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 16px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e5e7eb;
                ">
                <p style="margin: 0; color: #94a3b8; font-size: 11px">
                  © <%= year %> PH Healthcare · All rights reserved
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
```
